# ── 数据库连接 ──
DB_HOST=localhost
DB_NAME=geolabel
DB_USER=postgres
DB_PASSWORD=88888888
DB_PORT=5432

# ── Spring Boot 回调 ──
SPRING_BOOT_BASE_URL=http://localhost:1290

# ── SAM 模型路径 ──
SAM_MODEL_ID=sam2-hiera-tiny
SAM_CHECKPOINT=D:/sam2_checkpoints/sam2_hiera_tiny.pt

# ── 自动建筑分割 YOLO 模型路径 ──
AUTO_BUILDING_YOLO_PATH=F:/chromeDownload/best.pt

# ── CORS 允许源（逗号分隔） ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# ── 图像查找回退目录 ──
MINIO_UPLOAD_DIR=
GEOSERVER_LOCAL_COVERAGE_DIR=F:/PG-project/mapDataStore

# ── 模型保存与数据目录 ──
MODEL_SAVE_DIR=F:/PG-project/modalDataStore/trained_models
YOLO_DATASET_DIR=F:/PG-project/modalDataStore/yolo_datasets
VIS_OUTPUT_PATH=F:/PG-project/modalDataStore/PNG/visualization.png
